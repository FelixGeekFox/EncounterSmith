---
import Icon from './Icon.astro';
import { hooks, sparkIntro } from '~/data/generators/hooks';
import '~/styles/generator.css';

// Rendered server-side so the panel is never empty, even with scripts off.
const initial = hooks[0] as string;
---

<div class="panel panel--inverse spark-panel on-dark" data-spark>
  <p class="eyebrow">Tonight&rsquo;s spark</p>
  <p class="spark__text" data-spark-text>{initial}</p>
  <p class="note spark-panel__intro">{sparkIntro}</p>
  <div class="btn-row" data-print-hide>
    <button class="btn btn--accent btn--small" type="button" data-spark-next>
      <Icon name="spark" size={16} />
      <span>Another spark</span>
    </button>
    <button class="btn btn--ghost btn--small" type="button" data-spark-copy>
      <Icon name="copy" size={16} />
      <span>Copy</span>
    </button>
  </div>
  <p class="spark__status" role="status" aria-live="polite" data-spark-status></p>
</div>

<style>
  .spark-panel {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }

  .spark-panel__intro {
    margin: 0;
    color: var(--color-text-inverse-muted);
  }
</style>

<script>
  import { hooks } from '~/data/generators/hooks';
  import { copyText } from '~/scripts/clipboard';

  const panel = document.querySelector<HTMLElement>('[data-spark]');
  const text = panel?.querySelector<HTMLElement>('[data-spark-text]');
  const status = panel?.querySelector<HTMLElement>('[data-spark-status]');
  const next = panel?.querySelector<HTMLButtonElement>('[data-spark-next]');
  const copy = panel?.querySelector<HTMLButtonElement>('[data-spark-copy]');

  if (panel && text && next) {
    // Keep a short history so the same spark does not come round again quickly.
    const recent: string[] = [text.textContent?.trim() ?? ''];
    const memory = Math.min(8, Math.floor(hooks.length / 3));
    let statusTimer: number | undefined;

    const announce = (message: string): void => {
      if (!status) return;
      status.textContent = message;
      if (statusTimer !== undefined) window.clearTimeout(statusTimer);
      statusTimer = window.setTimeout(() => {
        status.textContent = '';
      }, 5000);
    };

    next.addEventListener('click', () => {
      let candidate = text.textContent ?? '';
      for (let attempt = 0; attempt < 24; attempt += 1) {
        const pick = hooks[Math.floor(Math.random() * hooks.length)];
        if (pick === undefined) continue;
        if (!recent.includes(pick)) {
          candidate = pick;
          break;
        }
        candidate = pick;
      }
      recent.unshift(candidate);
      recent.splice(memory);
      text.textContent = candidate;
      announce('New spark.');
    });

    copy?.addEventListener('click', () => {
      void (async () => {
        const ok = await copyText(text.textContent ?? '');
        announce(
          ok
            ? 'Spark copied.'
            : 'Copy failed. Your browser blocked clipboard access, so select the text and copy it manually.',
        );
      })();
    });
  }
</script>
