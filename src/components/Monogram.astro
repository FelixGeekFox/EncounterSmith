---
interface Props {
  size?: number;
  class?: string | undefined;
}

const { size = 40, class: className } = Astro.props;

/*
 * Temporary ES monogram: an original inline SVG built from a ring, a diamond
 * and two letterforms. It stands in for the illustrated monogram in the brand
 * guide, which has not been supplied as a production asset.
 */
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  role="img"
  aria-label="EncounterSmith monogram"
  focusable="false"
>
  <circle cx="24" cy="24" r="22.5" fill="var(--forest-deep, #22381f)" />
  <circle cx="24" cy="24" r="20.5" fill="none" stroke="var(--brand-bronze, #b08d57)" stroke-width="1" />
  <circle cx="24" cy="24" r="18" fill="none" stroke="var(--brand-bronze, #b08d57)" stroke-width="0.6" opacity="0.6" />
  <path d="M24 6.5 26 10l-2 3.5L22 10Z" fill="var(--brand-candlelight, #f5d78e)" />
  <text
    x="24"
    y="30.5"
    text-anchor="middle"
    font-family="Cinzel, Georgia, serif"
    font-size="17"
    font-weight="700"
    letter-spacing="0.5"
    fill="var(--brand-parchment, #eadcc6)"
  >ES</text>
</svg>
