---
import { site } from '@/data/site';
import { absolute } from '@/lib/url';

interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/tools/npc-generator". */
  path: string;
  ogType?: 'website' | 'article';
  image?: string | undefined;
  noindex?: boolean;
  jsonLd?: readonly Record<string, unknown>[];
}

const { title, description, path, ogType = 'website', image, noindex = false, jsonLd = [] } = Astro.props;

const canonical = absolute(site.url, path);
const ogImage = absolute(site.url, image ?? site.brand.ogImage);
const fullTitle = path === '/' ? title : `${title} | ${site.name}`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(site.brand.ogImageSize.width)} />
<meta property="og:image:height" content={String(site.brand.ogImageSize.height)} />
<meta property="og:image:alt" content="The EncounterSmith banner: the anvil-and-d20 emblem beside a cartographer's desk." />
<meta property="og:locale" content={site.locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonLd.map((entry) => <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />)}
