---
import Emblem from './Emblem.astro';
import { path } from '@/lib/url';

interface Props {
  eyebrow?: string | undefined;
  title: string;
  lede?: string | undefined;
  /** Rendered as a breadcrumb trail above the title. */
  crumbs?: readonly { label: string; href?: string }[];
}

const { eyebrow, title, lede, crumbs = [] } = Astro.props;
---

<section class="page-head">
  <div class="shell page-head__inner">
    <div class="page-head__text">
      {
        crumbs.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb">
            <ol>
              {crumbs.map((crumb, index) => (
                <li aria-current={index === crumbs.length - 1 ? 'page' : undefined}>
                  {crumb.href ? <a href={path(crumb.href)}>{crumb.label}</a> : crumb.label}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lede && <p class="lede page-head__lede">{lede}</p>}
      <slot />
    </div>
    <Emblem size={128} class="page-head__mark" loading="eager" />
  </div>
</section>

<style>
  .page-head {
    position: relative;
    padding-block: var(--space-lg) var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .page-head__inner {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    justify-content: space-between;
  }

  .page-head__text {
    max-width: 46rem;
  }

  .page-head h1 {
    margin-top: var(--space-3xs);
  }

  .page-head__lede {
    margin-top: var(--space-sm);
    max-width: 52ch;
  }

  /* The supplied emblem as a quiet watermark, so the page has the brand on it
     without another copy of the wordmark competing with the heading. */
  .page-head__mark {
    flex: none;
    display: none;
    opacity: 0.5;
  }

  @media (min-width: 62rem) {
    .page-head__mark {
      display: block;
    }
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0 0 var(--space-2xs);
    padding: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .crumbs li + li::before {
    content: '\2666';
    margin-right: 0.35rem;
    color: var(--color-accent);
  }
</style>
