---
/*
 * An original CSS and SVG composition standing in for the illustrated banner
 * artwork in the brand guide: layered ridges, a dashed map route, pines and a
 * lit d20. Entirely decorative, so it is hidden from assistive technology.
 *
 * Replace it with production artwork by dropping an image into public/images/
 * and swapping the <svg> below. See public/brand/README.md.
 */
---

<div class="hero-panel">
  <svg class="hero-panel__art" viewBox="0 0 480 360" width="480" height="360" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="hp-sky" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#2b4429" />
        <stop offset="58%" stop-color="#22381f" />
        <stop offset="100%" stop-color="#1a2b1c" />
      </linearGradient>
      <radialGradient id="hp-glow" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0%" stop-color="#f5d78e" stop-opacity="0.55" />
        <stop offset="60%" stop-color="#b08d57" stop-opacity="0.16" />
        <stop offset="100%" stop-color="#b08d57" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="hp-die" x1="0" y1="0" x2="0.6" y2="1">
        <stop offset="0%" stop-color="#3c5b38" />
        <stop offset="100%" stop-color="#1e3320" />
      </linearGradient>
    </defs>

    <rect width="480" height="360" fill="url(#hp-sky)" />
    <circle cx="330" cy="112" r="130" fill="url(#hp-glow)" />

    <g fill="#f5d78e" opacity="0.55">
      <path d="M62 54 63.4 58 67.4 59.4 63.4 60.8 62 64.8 60.6 60.8 56.6 59.4 60.6 58Z" />
      <path d="M140 32 141 34.8 143.8 35.8 141 36.8 140 39.6 139 36.8 136.2 35.8 139 34.8Z" />
      <path d="M418 66 419.2 69.2 422.4 70.4 419.2 71.6 418 74.8 416.8 71.6 413.6 70.4 416.8 69.2Z" />
      <path d="M244 44 245 46.6 247.6 47.6 245 48.6 244 51.2 243 48.6 240.4 47.6 243 46.6Z" />
    </g>

    <path
      d="M0 238 60 188 100 214 150 158 200 208 250 174 310 224 360 184 420 220 480 194V360H0Z"
      fill="#1c2f1d"
      opacity="0.85"
    />
    <path
      d="M0 274 70 234 130 264 190 224 250 262 320 232 390 270 440 244 480 268V360H0Z"
      fill="#16261a"
    />

    <g fill="#101d13">
      <path d="M96 300l10 24H86Zm0 12 14 30H82Z" />
      <path d="M126 294l8 20h-16Zm0 10 12 26h-24Z" />
      <path d="M402 292l9 22h-18Zm0 11 13 28h-26Z" />
      <path d="M432 302l8 20h-16Zm0 10 12 26h-24Z" />
      <path d="M58 310l9 22H49Zm0 11 13 28H45Z" />
    </g>

    <path
      d="M24 356C96 326 76 300 166 290 250 281 286 268 330 244"
      fill="none"
      stroke="#b08d57"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-dasharray="1 11"
      opacity="0.9"
    />
    <path
      d="M24 356C96 326 76 300 166 290 250 281 286 268 330 244"
      fill="none"
      stroke="#f5d78e"
      stroke-width="1"
      stroke-linecap="round"
      stroke-dasharray="0.5 11"
      opacity="0.5"
    />
    <g stroke="#f5d78e" stroke-width="2.2" stroke-linecap="round" opacity="0.9">
      <path d="M160 283l12 12m0-12-12 12" />
    </g>

    <g transform="translate(330 112)">
      <path d="M0-54 46.8-27v54L0 54-46.8 27v-54Z" fill="url(#hp-die)" stroke="#b08d57" stroke-width="2" stroke-linejoin="round" />
      <path d="M0-54 33 12h-66Z" fill="none" stroke="#b08d57" stroke-width="1.4" stroke-linejoin="round" opacity="0.85" />
      <path d="M-33 12 0 54 33 12" fill="none" stroke="#b08d57" stroke-width="1.4" stroke-linejoin="round" opacity="0.6" />
      <path d="M-46.8-27-33 12M46.8-27 33 12" fill="none" stroke="#b08d57" stroke-width="1.4" opacity="0.6" />
      <text
        x="0"
        y="-6"
        text-anchor="middle"
        font-family="Cinzel, Georgia, serif"
        font-size="26"
        font-weight="700"
        fill="#f5d78e"
      >20</text>
    </g>

    <g transform="translate(74 92)" opacity="0.7">
      <circle r="26" fill="none" stroke="#b08d57" stroke-width="1.4" />
      <circle r="20" fill="none" stroke="#b08d57" stroke-width="0.7" opacity="0.7" />
      <path d="M0-22 4.6-4.6 22 0 4.6 4.6 0 22-4.6 4.6-22 0-4.6-4.6Z" fill="#f5d78e" opacity="0.85" />
    </g>
  </svg>
</div>

<style>
  .hero-panel {
    position: relative;
    border: 1px solid rgba(176, 141, 87, 0.55);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-deep);
    background: var(--forest-ink);
  }

  .hero-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(245, 215, 142, 0.18);
    border-radius: inherit;
  }

  .hero-panel__art {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 62rem) {
    .hero-panel__art {
      aspect-ratio: 5 / 4;
      object-fit: cover;
    }
  }
</style>
