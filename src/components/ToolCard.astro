---
import type { Tool } from '@/data/tools';
import { path } from '@/lib/url';

interface Props {
  tool: Tool;
  /** Show the full field list. Used on the tools index. */
  detailed?: boolean;
  /** Heading level, so the card sits correctly in each page's outline. */
  level?: 2 | 3;
}

const { tool, detailed = false, level = 3 } = Astro.props;
const Name = `h${level}` as 'h2' | 'h3';
---

<article class="tool">
  <Name class="tool__name"><a href={path(tool.href)}>{tool.name}</a></Name>
  <p class="tool__summary">{detailed ? tool.produces : tool.summary}</p>
  {
    detailed && (
      <ul class="tool__fields">
        {tool.fields.map((field) => (
          <li>{field}</li>
        ))}
      </ul>
    )
  }
  <p class="tool__go" aria-hidden="true">Open the generator &rarr;</p>
</article>

<style>
  /* A column on a workbench rather than another bordered card: separated by a
     hairline, with a bronze rule that grows on hover. */
  .tool {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    padding-block: var(--space-sm) var(--space-md);
  }

  .tool::before {
    content: '';
    display: block;
    width: 3rem;
    height: 2px;
    margin-bottom: var(--space-2xs);
    background: var(--color-accent);
    transition: width 180ms ease;
  }

  .tool:hover::before,
  .tool:focus-within::before {
    width: 6rem;
  }

  .tool__name {
    margin: 0;
    font-size: var(--text-xl);
  }

  .tool__name a {
    color: var(--color-heading);
    text-decoration: none;
  }

  .tool__name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .tool__name a:hover {
    color: var(--color-primary-hover);
  }

  .tool__summary {
    color: var(--color-text-muted);
  }

  .tool__fields {
    list-style: none;
    margin: var(--space-3xs) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .tool__fields li {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--clay-ink);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.12rem 0.55rem;
  }

  .tool__go {
    margin-top: var(--space-3xs);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
</style>
