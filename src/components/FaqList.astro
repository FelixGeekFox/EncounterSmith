---
import type { FaqItem } from '~/data/faq';

interface Props {
  items: readonly FaqItem[];
  /** Open the first item so the section does not read as an empty list. */
  openFirst?: boolean;
}

const { items, openFirst = false } = Astro.props;
---

<div class="faq-list">
  {
    items.map((item, index) => (
      <details class="faq-item" open={openFirst && index === 0}>
        <summary>{item.question}</summary>
        <div>
          <p>{item.answer}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq-list {
    border-top: 1px solid var(--color-border);
    max-width: 52rem;
  }
</style>
