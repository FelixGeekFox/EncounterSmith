---
// Cinzel and Lato are bundled through Fontsource and served from this domain.
// No font request ever leaves the visitor's browser for a third party.
import '@fontsource/cinzel/600.css';
import '@fontsource/cinzel/700.css';
import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';
import '@/styles/global.css';

import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Meta from '@/components/Meta.astro';
import { site } from '@/data/site';
import { path as withBase } from '@/lib/url';

interface Props {
  title: string;
  description: string;
  path: string;
  ogType?: 'website' | 'article';
  image?: string | undefined;
  noindex?: boolean;
  jsonLd?: readonly Record<string, unknown>[];
}

const { title, description, path, ogType, image, noindex, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2f4a32" />
    <meta name="generator" content={Astro.generator} />
    <style
      is:inline
      set:html={`:root{--texture:url('${withBase('/textures/parchment.webp')}')}`}
    ></style>
    <link rel="icon" type="image/png" sizes="32x32" href={withBase(site.brand.favicon32)} />
    <link rel="icon" type="image/png" sizes="64x64" href={withBase(site.brand.favicon64)} />
    <link rel="apple-touch-icon" href={withBase(site.brand.appleTouchIcon)} />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <Meta
      title={title}
      description={description}
      path={path}
      ogType={ogType}
      image={image}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    {
      /*
        Analytics slot. Nothing is loaded here. If PUBLIC_FEATURE_ANALYTICS is
        ever switched on, add the provider snippet in this position and update
        the privacy page in the same change.
      */
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  main:focus {
    outline: none;
  }
</style>
