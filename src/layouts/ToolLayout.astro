---
import BaseLayout from './BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import GeneratorShell from '@/components/GeneratorShell.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ToolCard from '@/components/ToolCard.astro';
import { tools, type Tool } from '@/data/tools';
import { site } from '@/data/site';
import type { GeneratorDef } from '@/scripts/generator';
import { absolute } from '@/lib/url';

interface Props {
  tool: Tool;
  def: GeneratorDef;
  /** Heading above the guidance column. */
  guidance: string;
}

const { tool, def, guidance } = Astro.props;
const others = tools.filter((entry) => entry.slug !== tool.slug);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `${site.name} ${tool.name}`,
    url: absolute(site.url, tool.href),
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any modern web browser',
    isAccessibleForFree: true,
    description: tool.metaDescription,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'AUD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absolute(site.url, '/') },
      { '@type': 'ListItem', position: 2, name: 'Tools', item: absolute(site.url, '/tools') },
      { '@type': 'ListItem', position: 3, name: tool.name, item: absolute(site.url, tool.href) },
    ],
  },
];
---

<BaseLayout title={tool.metaTitle} description={tool.metaDescription} path={tool.href} jsonLd={jsonLd}>
  <PageHeader
    eyebrow="Free tool"
    title={tool.name}
    lede={tool.lede}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools' }, { label: tool.name }]}
  />

  <div class="band band--tight">
    <div class="shell">
      <GeneratorShell def={def} />
    </div>
  </div>

  <section class="band band--quiet">
    <div class="shell tool-foot">
      <div class="prose">
        <SectionHeading eyebrow="At the table" title={guidance} />
        <slot />
        <h3>About the tables</h3>
        <p>
          Every entry is original and written to stay system-friendly, so nothing needs converting.
          There are no statistics here: assign those the way your own game does. The generator runs
          entirely in your browser, and nothing you forge is stored or sent anywhere.
        </p>
      </div>

      <aside class="tool-foot__aside">
        <h2 class="tool-foot__heading">The other two</h2>
        <div class="tool-foot__list">
          {others.map((entry) => <ToolCard tool={entry} />)}
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .tool-foot {
    display: grid;
    gap: var(--space-lg);
    align-items: start;
  }

  @media (min-width: 66rem) {
    .tool-foot {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }

  .tool-foot__heading {
    font-size: var(--text-lg);
  }

  .tool-foot__list {
    display: grid;
    gap: var(--space-2xs);
  }

  .tool-foot__list > :global(.tool + .tool) {
    border-top: 1px solid var(--color-border);
  }
</style>
