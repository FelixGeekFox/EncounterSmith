# EncounterSmith environment configuration
#
# Copy to `.env` for local development, and set the same variables in the host's
# build environment for production (Cloudflare Pages: Settings -> Environment
# variables).
#
# Every variable here is PUBLIC_: it is compiled into the static output and is
# visible to anyone who views source. NEVER put an API key, a secret or a
# private token in this file or in .env.

# --- Site -------------------------------------------------------------------
# Canonical origin, no trailing slash. Drives canonical links, Open Graph URLs,
# robots.txt and the generated sitemap.
PUBLIC_SITE_URL="https://encountersmith.com"

# Subdirectory the site is served from. Leave unset (or "/") for a root
# deployment: Cloudflare Pages, Netlify, a custom domain. A GitHub Pages
# project site is served from /<repo>/, so it needs the repository name here.
# The GitHub Actions workflow sets this automatically.
# PUBLIC_BASE_PATH="/EncounterSmith"

# Shown in the footer, the FAQ and both legal pages.
PUBLIC_CONTACT_EMAIL="hello@encountersmith.com"

# --- Email provider ---------------------------------------------------------
# The form POST endpoint from MailerLite, Kit, Buttondown, Beehiiv or similar.
# LEAVE UNSET until a real endpoint exists: the sign-up forms then render as
# inactive with an honest explanation instead of pretending to work.
# PUBLIC_EMAIL_FORM_ACTION="https://assets.mailerlite.com/jsonp/000000/forms/000000/subscribe"
# Provider name, used only in the privacy notice.
# PUBLIC_EMAIL_PROVIDER="MailerLite"

# --- Checkout and preview links --------------------------------------------
# A purchase URL turns that pack's button into "Buy the pack".
# A preview URL alone turns it into "Preview the pack".
# Neither leaves an honest "Coming soon" label and no button at all.
# PUBLIC_PRODUCT_EMERGENCY_KIT_URL="https://your-store.example/emergency-session-kit"
# PUBLIC_PRODUCT_EMERGENCY_KIT_PREVIEW_URL=""
# PUBLIC_PRODUCT_NPC_SECRETS_URL=""
# PUBLIC_PRODUCT_NPC_SECRETS_PREVIEW_URL=""
# PUBLIC_PRODUCT_WICKHOLLOW_URL=""
# PUBLIC_PRODUCT_WICKHOLLOW_PREVIEW_URL=""

# --- Feature flags ----------------------------------------------------------
# Accepts true/false, 1/0, yes/no, on/off. Defaults in brackets.
PUBLIC_FEATURE_PRODUCTS="true"          # [true]  Products page and nav entry
PUBLIC_FEATURE_SMITH_PLUS="true"        # [true]  Smith+ page and home section
PUBLIC_FEATURE_SMITH_PLUS_PRICE="false" # [false] Only true once a real price AND checkout exist
PUBLIC_FEATURE_PRODUCT_SCHEMA="false"   # [false] Only true once product data is complete
PUBLIC_FEATURE_ANALYTICS="false"        # [false] No analytics script is loaded either way

# Rendered only when PUBLIC_FEATURE_SMITH_PLUS_PRICE is true.
# PUBLIC_SMITH_PLUS_PRICE="A$9.95"
# PUBLIC_SMITH_PLUS_INTERVAL="month"

# --- Legal ------------------------------------------------------------------
# Set true ONLY after a lawyer has reviewed /privacy and /terms. The flag does
# not change what visitors see; it is the record of whether the review happened.
PUBLIC_LEGAL_REVIEWED="false"
PUBLIC_LEGAL_UPDATED="15 September 2026"
PUBLIC_LEGAL_ENTITY="EncounterSmith"
PUBLIC_LEGAL_JURISDICTION="New South Wales, Australia"
